# Opcional por enquanto: sem .env, valem os padrões abaixo.

# Onde está o ComfyUI portátil (a pasta que tem o python_embeded) e onde ele
# atende. Lidos pela API e pelo ícone da bandeja (scripts\tray.ps1).
COMFYUI_DIR="C:\IA\ComfyUI"
COMFYUI_URL="http://127.0.0.1:8188"

# Argumentos extras para o ComfyUI quando o ícone da bandeja o inicia. Relidos
# a cada partida: edite e use "Parar" e "Iniciar o ComfyUI" no menu.
#   --fast fp16_accumulation   mais rápido em RTX 30/40, precisão um pouco menor
#                              (o mesmo do run_nvidia_gpu_fast_fp16_accumulation.bat)
COMFYUI_ARGS=""

# Onde ficam os arquivos: referências enviadas e, depois, os outputs do
# ComfyUI. O banco guarda só o caminho relativo a esta pasta.
ARQUIVOS_DIR="D:\Creativa"

# Outro Creativa que já tem esses arquivos, para quando esta máquina roda com o
# banco de outra (ver "Rodar de outra máquina" no CLAUDE.md): o que faltar na
# pasta acima é redirecionado para lá, e o navegador busca direto pelo tailnet.
# Vazio (o normal, na máquina que tem os arquivos): o que falta é 404.
ARQUIVOS_REMOTOS=""

# A porta em que o ComfyUI foi publicado no tailnet (publicar-no-tailnet.ps1):
# o botão "Abrir o ComfyUI" usa este endereço quando o site é acessado de outro PC.
COMFYUI_PORTA_TAILNET="8445"

# A LLM local do assistente de prompt (Ollama, que fica na bandeja e sobe com
# o Windows). O modelo é relido a cada uso: trocar aqui não pede reinício.
# Baixe antes com: ollama pull <modelo>
# Noutra máquina, com a LLM de casa: o repasse do Creativa de lá,
# "https://overdrive.tail2c882a.ts.net:8444/ollama".
OLLAMA_URL="http://127.0.0.1:11434"
ASSISTENTE_MODELO="gemma4:12b-it-qat"

# O Blender, que monta o blockout da etapa Geometria (blender/creativa/render.py).
# Vazio: procura o mais novo em Program Files ("Blender 5.2", "Blender Foundation\...").
BLENDER_EXE=""
