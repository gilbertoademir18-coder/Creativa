# Opcional por enquanto: sem .env, valem os padrões abaixo.

# Onde está o ComfyUI portátil (a pasta que tem o python_embeded) e onde ele
# atende. Lidos pela API e pelo ícone da bandeja (scripts\tray.ps1).
COMFYUI_DIR="C:\AI\ComfyUI"
COMFYUI_URL="http://127.0.0.1:8188"

# Argumentos extras para o ComfyUI quando o ícone da bandeja o inicia. Relidos
# a cada partida: edite e use "Parar" e "Iniciar o ComfyUI" no menu.
#   --fast fp16_accumulation   mais rápido em RTX 30/40, precisão um pouco menor
#                              (o mesmo do run_nvidia_gpu_fast_fp16_accumulation.bat)
COMFYUI_ARGS=""

# Onde ficam os arquivos: referências enviadas e, depois, os outputs do
# ComfyUI. O banco guarda só o caminho relativo a esta pasta.
ARQUIVOS_DIR="D:\Creativa"
