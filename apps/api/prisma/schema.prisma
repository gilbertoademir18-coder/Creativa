// Schema do Creativa.
//
// A conexão vem de `prisma.config.ts`, que lê DATABASE_URL do `.env` da raiz.
// Ids são UUID: aparecem em URLs (/assets/<id>, /cenas/<id>) e não devem
// contar quantos registros existem nem deixar adivinhar o vizinho.
//
// A árvore:
//
//   Projeto
//   ├── Asset ─────────── Referências, Gerações
//   └── Cena (storyboard)
//       └── Shot ──────── Referências, Gerações
//
//   Geração ── usa Referências e Outputs como entrada ── produz Outputs
//
// Asset e Cena podem estar soltos (sem projeto). Shot sempre tem cena.
//
// Apagar: o que tem arquivo em disco ou histórico de geração é protegido
// (Restrict) — o banco recusa, e a tela explica o que remover antes. Só cai
// em cascata o que não carrega nada sozinho: os shots vazios de uma cena e as
// entradas de uma geração.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoAsset {
  PERSONAGEM
  CENARIO
  OBJETO
  OUTRO

  @@map("tipo_asset")
}

enum TipoReferencia {
  IMAGEM
  TEXTO
  VIDEO

  @@map("tipo_referencia")
}

enum StatusGeracao {
  /// Cadastrada, ainda não enviada ao ComfyUI.
  RASCUNHO
  /// Enviada ao ComfyUI, esperando a vez na fila dele.
  NA_FILA
  EXECUTANDO
  CONCLUIDA
  FALHOU
  CANCELADA

  @@map("status_geracao")
}

enum TipoOutput {
  IMAGEM
  VIDEO
  AUDIO
  OUTRO

  @@map("tipo_output")
}

/// "Poker de Camila", "Anime Katsuragi"...
model Projeto {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  assets Asset[]
  cenas  Cena[]

  @@map("projeto")
}

/// Personagem, cenário, objeto... Pode pertencer a um projeto ou estar solto.
model Asset {
  id        String    @id @default(uuid()) @db.Uuid
  /// Apagar o projeto solta o asset, não o apaga.
  projetoId String?   @map("projeto_id") @db.Uuid
  tipo      TipoAsset
  nome      String
  descricao String?
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime  @updatedAt @map("editado_em") @db.Timestamptz

  projeto     Projeto?     @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  referencias Referencia[]
  geracoes    Geracao[]

  @@index([projetoId])
  @@index([tipo])
  @@map("asset")
}

/// "Cena da ponte", "cena da dança"... Pode pertencer a um projeto ou estar solta.
model Cena {
  id         String   @id @default(uuid()) @db.Uuid
  projetoId  String?  @map("projeto_id") @db.Uuid
  nome       String
  descricao  String?
  /// Texto livre por enquanto: roteiro, planos, intenção da cena.
  storyboard String   @default("")
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm  DateTime @updatedAt @map("editado_em") @db.Timestamptz

  projeto Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  shots   Shot[]

  @@index([projetoId])
  @@map("cena")
}

/// Um plano da cena. Toda cena nasce com um; todo shot tem cena.
model Shot {
  id        String   @id @default(uuid()) @db.Uuid
  cenaId    String   @map("cena_id") @db.Uuid
  nome      String
  descricao String?
  /// Posição na cena, a partir de 0.
  ordem     Int
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  /// Apagar a cena leva os shots — mas só os vazios: referência e geração
  /// presas a um shot barram a cascata (Restrict nelas).
  cena        Cena         @relation(fields: [cenaId], references: [id], onDelete: Cascade)
  referencias Referencia[]
  geracoes    Geracao[]

  @@index([cenaId, ordem])
  @@map("shot")
}

/// Material externo que o usuário envia: imagem, texto ou vídeo.
///
/// Pertence a um asset, a um shot, ou a nenhum (solta) — nunca aos dois; um
/// CHECK na migração garante.
model Referencia {
  id           String         @id @default(uuid()) @db.Uuid
  assetId      String?        @map("asset_id") @db.Uuid
  shotId       String?        @map("shot_id") @db.Uuid
  tipo         TipoReferencia
  nome         String
  /// O conteúdo, quando é TEXTO. Texto mora no banco, não em arquivo.
  texto        String?
  /// Caminho relativo à pasta de arquivos (ARQUIVOS_DIR), com `/`. Relativo
  /// para que mudar a pasta de lugar não invalide o banco inteiro.
  arquivo      String?
  nomeOriginal String?        @map("nome_original")
  mime         String?
  tamanhoBytes BigInt?        @map("tamanho_bytes")
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm    DateTime       @updatedAt @map("editado_em") @db.Timestamptz

  asset    Asset?           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  shot     Shot?            @relation(fields: [shotId], references: [id], onDelete: Restrict)
  /// Uma referência usada numa geração não se apaga: a geração perderia
  /// o registro do que a alimentou.
  usadaEm  GeracaoEntrada[]

  @@index([assetId])
  @@index([shotId])
  @@index([tipo])
  @@map("referencia")
}

/// Tudo o que foi usado para gerar algo no ComfyUI — e o que saiu (Outputs).
///
/// Cada envio ao ComfyUI é uma Rodada: "Gerar" cria a primeira, "Gerar mais"
/// cria outras com as mesmas configurações e seed nova. Os outputs de todas
/// as rodadas ficam juntos na geração.
///
/// O tipo ("Placa de cenário", "Character sheet"...) e o workflow são chaves
/// do código (apps/api/src/geracao/), não do banco: cada workflow do ComfyUI
/// é programado lá, com os campos que expõe e o grafo que monta. Os valores
/// dos campos ficam em `parametros`.
///
/// Pertence a um asset, a um shot, ou a nenhum — nunca aos dois (CHECK).
model Geracao {
  id             String        @id @default(uuid()) @db.Uuid
  assetId        String?       @map("asset_id") @db.Uuid
  shotId         String?       @map("shot_id") @db.Uuid
  /// Opcional: sem nome, a tela mostra o começo do prompt.
  nome           String?
  /// Chave do tipo de geração no código (ex.: "placa-cenario").
  tipo           String
  /// Chave do workflow no código (ex.: "placa-cenario-zimage").
  workflow       String
  /// Cópia do campo "prompt" dos parâmetros, quando o workflow tem um: é o
  /// que a busca e a listagem usam.
  prompt         String        @default("")
  /// O modelo principal que o workflow usa, gravado no envio — para saber
  /// depois com o que a imagem foi feita, mesmo que o código mude.
  modelo         String?
  /// Os valores dos campos do workflow (prompt, seed, tamanho...), como o
  /// formulário deixou. A seed sorteada de cada envio fica na Rodada.
  parametros     Json          @default("{}")
  /// RASCUNHO até o primeiro envio; depois, o resumo das rodadas (alguma na
  /// fila/executando, ou o resultado da mais recente). Mantido pelo código
  /// em geracao/execucao.ts.
  status         StatusGeracao @default(RASCUNHO)
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm      DateTime      @updatedAt @map("editado_em") @db.Timestamptz

  asset    Asset?           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  shot     Shot?            @relation(fields: [shotId], references: [id], onDelete: Restrict)
  entradas GeracaoEntrada[]
  rodadas  Rodada[]
  outputs  Output[]

  @@index([assetId])
  @@index([shotId])
  @@index([status])
  @@index([tipo])
  @@map("geracao")
}

/// Um envio de uma geração ao ComfyUI. A seed "aleatória" é sorteada aqui e
/// gravada nos parâmetros: dá para saber qual seed fez cada imagem.
model Rodada {
  id            String        @id @default(uuid()) @db.Uuid
  geracaoId     String        @map("geracao_id") @db.Uuid
  /// NA_FILA → EXECUTANDO → CONCLUIDA / FALHOU / CANCELADA (nunca RASCUNHO).
  status        StatusGeracao @default(NA_FILA)
  /// Os valores exatos deste envio, com a seed já sorteada.
  parametros    Json
  /// O grafo exatamente como foi enviado. O código do workflow pode mudar
  /// depois; isto é o que de fato rodou.
  grafoEnviado  Json          @map("grafo_enviado")
  /// O id que o ComfyUI devolve no POST /prompt.
  promptIdComfy String?       @unique @map("prompt_id_comfy")
  erro          String?
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  /// Início e fim de verdade no ComfyUI, sem o tempo de fila.
  iniciadaEm    DateTime?     @map("iniciada_em") @db.Timestamptz
  concluidaEm   DateTime?     @map("concluida_em") @db.Timestamptz

  geracao Geracao  @relation(fields: [geracaoId], references: [id], onDelete: Cascade)
  outputs Output[]

  @@index([geracaoId])
  @@index([status])
  @@map("rodada")
}

/// O que entrou numa geração: uma referência ou um output de outra geração.
/// Exatamente um dos dois (CHECK).
model GeracaoEntrada {
  id           String  @id @default(uuid()) @db.Uuid
  geracaoId    String  @map("geracao_id") @db.Uuid
  referenciaId String? @map("referencia_id") @db.Uuid
  outputId     String? @map("output_id") @db.Uuid
  ordem        Int

  geracao    Geracao     @relation(fields: [geracaoId], references: [id], onDelete: Cascade)
  referencia Referencia? @relation(fields: [referenciaId], references: [id], onDelete: Restrict)
  output     Output?     @relation(fields: [outputId], references: [id], onDelete: Restrict)

  @@unique([geracaoId, referenciaId])
  @@unique([geracaoId, outputId])
  @@index([referenciaId])
  @@index([outputId])
  @@map("geracao_entrada")
}

/// Um arquivo que uma geração produziu.
model Output {
  id           String     @id @default(uuid()) @db.Uuid
  /// Geração com outputs não se apaga: eles têm arquivo em disco.
  geracaoId    String     @map("geracao_id") @db.Uuid
  /// A rodada que produziu este output (e, nela, a seed).
  rodadaId     String?    @map("rodada_id") @db.Uuid
  tipo         TipoOutput
  /// Caminho relativo à pasta de arquivos (ARQUIVOS_DIR), com `/`.
  arquivo      String
  mime         String?
  tamanhoBytes BigInt?    @map("tamanho_bytes")
  largura      Int?
  altura       Int?
  duracaoSeg   Decimal?   @map("duracao_seg") @db.Decimal(10, 3)
  favorito     Boolean    @default(false)
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz

  geracao Geracao          @relation(fields: [geracaoId], references: [id], onDelete: Restrict)
  rodada  Rodada?          @relation(fields: [rodadaId], references: [id], onDelete: Restrict)
  /// Output usado como entrada de outra geração não se apaga.
  usadoEm GeracaoEntrada[]

  @@index([geracaoId])
  @@index([rodadaId])
  @@map("output")
}
