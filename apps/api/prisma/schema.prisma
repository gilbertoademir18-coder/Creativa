// Schema do Creativa.
//
// A conexão vem de `prisma.config.ts`, que lê DATABASE_URL do `.env` da raiz.
// Ids são UUID: aparecem em URLs (/assets/<id>, /cenas/<id>) e não devem
// contar quantos registros existem nem deixar adivinhar o vizinho.
//
// A árvore:
//
//   Projeto
//   ├── Asset ─────────────────── Referências, Outputs
//   ├── Lista de vídeos ("Temporada 1", "Trailers")
//   │   └── Vídeo ("EP01")
//   │       └── Cena (storyboard)
//   │           └── Shot ──────── Referências, Outputs
//   └── Cena sem vídeo
//       └── Shot
//
// Não há cadastro de "geração": o Gerador é um recurso do código
// (src/geracao/), usado de dentro do asset ou do shot. Cada clique em
// "Gerar" vira Execuções na fila do ComfyUI, e cada imagem que sai é um
// Output que guarda tudo o que foi usado para gerá-la.
//
// Asset e Cena podem estar soltos (sem projeto). Shot sempre tem cena.
//
// Apagar: o que tem arquivo em disco ou histórico de geração é protegido
// (Restrict) — o banco recusa, e a tela explica o que remover antes. Só cai
// em cascata o que não carrega nada sozinho: os shots vazios de uma cena e o
// histórico da fila (execuções).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoAsset {
  PERSONAGEM
  CENARIO
  OBJETO
  OUTRO

  @@map("tipo_asset")
}

enum TipoReferencia {
  IMAGEM
  TEXTO
  VIDEO

  @@map("tipo_referencia")
}

enum StatusExecucao {
  /// Enviada ao ComfyUI, esperando a vez na fila dele.
  NA_FILA
  EXECUTANDO
  CONCLUIDA
  FALHOU
  CANCELADA

  @@map("status_execucao")
}

enum TipoOutput {
  IMAGEM
  VIDEO
  AUDIO
  OUTRO

  @@map("tipo_output")
}

/// "Poker de Camila", "Anime Katsuragi"...
model Projeto {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String
  /// A descrição atual (a última versão), no modelo de docs/descricao-de-projeto.md.
  descricao       String?
  /// O número da versão atual da descrição (0: nunca foi salva). Quem salva
  /// manda o número em que se baseou: se outra versão entrou no meio, a API recusa.
  descricaoVersao Int      @default(0) @map("descricao_versao")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm       DateTime @updatedAt @map("editado_em") @db.Timestamptz

  assets           Asset[]
  cenas            Cena[]
  listas           ListaVideos[]
  assistentes      Assistente[]
  versoesDescricao VersaoDescricao[]

  @@map("projeto")
}

/// Quem salvou uma versão da descrição: a tela do Creativa ou a skill do Claude.
enum OrigemVersao {
  TELA
  CLAUDE

  @@map("origem_versao")
}

/// O histórico da descrição do projeto: cada vez que ela é salva com texto
/// diferente, entra uma versão nova. Versões nunca se editam nem se apagam;
/// restaurar uma antiga é salvar o texto dela como versão nova.
model VersaoDescricao {
  id        String       @id @default(uuid()) @db.Uuid
  projetoId String       @map("projeto_id") @db.Uuid
  /// 1, 2, 3... por projeto.
  numero    Int
  /// null: a descrição foi apagada nesta versão.
  texto     String?
  origem    OrigemVersao @default(TELA)
  /// O que mudou, em uma linha ("+ Ficha do gato; Recorrentes: 1 gag").
  nota      String?
  criadoEm  DateTime     @default(now()) @map("criado_em") @db.Timestamptz

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, numero])
  @@map("versao_descricao")
}

/// Personagem, cenário, objeto... Pode pertencer a um projeto ou estar solto.
model Asset {
  id              String    @id @default(uuid()) @db.Uuid
  /// Apagar o projeto solta o asset, não o apaga.
  projetoId       String?   @map("projeto_id") @db.Uuid
  tipo            TipoAsset
  nome            String
  descricao       String?
  /// Onde o Gerador deste asset parou: tipo, workflow, valores, assistente
  /// (pelo nome) e ideia. Salvo sozinho enquanto se mexe no formulário.
  rascunhoGerador Json?     @map("rascunho_gerador")
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm       DateTime  @updatedAt @map("editado_em") @db.Timestamptz

  projeto     Projeto?     @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  referencias Referencia[]
  execucoes   Execucao[]
  outputs     Output[]

  @@index([projetoId])
  @@index([tipo])
  @@map("asset")
}

/// "Cena da ponte", "cena da dança"... Pode pertencer a um projeto ou estar solta.
model Cena {
  id         String   @id @default(uuid()) @db.Uuid
  projetoId  String?  @map("projeto_id") @db.Uuid
  /// O vídeo em que a cena entra, se entra em algum. O projeto da cena é
  /// sempre o da lista do vídeo (a API garante). Apagar o vídeo solta a
  /// cena, que volta a ser "sem vídeo" do projeto.
  videoId    String?  @map("video_id") @db.Uuid
  /// Posição dentro do vídeo, a partir de 0. Fora de vídeo, não importa.
  ordem      Int      @default(0)
  nome       String
  descricao  String?
  /// Texto livre por enquanto: roteiro, planos, intenção da cena.
  storyboard String   @default("")
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm  DateTime @updatedAt @map("editado_em") @db.Timestamptz

  projeto Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  video   Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  shots   Shot[]

  @@index([projetoId])
  @@index([videoId, ordem])
  @@map("cena")
}

/// Um agrupamento de vídeos de um projeto: "Temporada 1", "Trailers",
/// "Aberturas". Genérico de propósito — nem todo projeto é uma série.
model ListaVideos {
  id        String   @id @default(uuid()) @db.Uuid
  /// Lista é sempre de um projeto. Apagar o projeto leva as listas e os
  /// vídeos (são só agrupadores); as cenas ficam, soltas.
  projetoId String   @map("projeto_id") @db.Uuid
  nome      String
  descricao String?
  /// Posição no projeto, a partir de 0.
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  videos  Video[]

  @@index([projetoId, ordem])
  @@map("lista_videos")
}

/// Um vídeo de uma lista ("EP01 — O Clube"), feito de cenas em ordem.
model Video {
  id        String   @id @default(uuid()) @db.Uuid
  listaId   String   @map("lista_id") @db.Uuid
  nome      String
  /// Sinopse, roteiro: markdown, com o editor visual.
  descricao String?
  /// Posição na lista, a partir de 0.
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm DateTime @updatedAt @map("editado_em") @db.Timestamptz

  /// Apagar a lista leva os vídeos; as cenas deles ficam, sem vídeo.
  lista ListaVideos @relation(fields: [listaId], references: [id], onDelete: Cascade)
  cenas Cena[]

  @@index([listaId, ordem])
  @@map("video")
}

/// Um plano da cena. Toda cena nasce com um; todo shot tem cena.
model Shot {
  id              String   @id @default(uuid()) @db.Uuid
  cenaId          String   @map("cena_id") @db.Uuid
  nome            String
  descricao       String?
  /// Posição na cena, a partir de 0.
  ordem           Int
  /// Onde o Gerador deste shot parou (o mesmo formato do asset).
  rascunhoGerador Json?    @map("rascunho_gerador")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm       DateTime @updatedAt @map("editado_em") @db.Timestamptz

  /// Apagar a cena leva os shots — mas só os vazios: referência e output
  /// presos a um shot barram a cascata (Restrict neles).
  cena        Cena         @relation(fields: [cenaId], references: [id], onDelete: Cascade)
  referencias Referencia[]
  execucoes   Execucao[]
  outputs     Output[]

  @@index([cenaId, ordem])
  @@map("shot")
}

/// Material externo que o usuário envia: imagem, texto ou vídeo.
///
/// Pertence a um asset, a um shot, ou a nenhum (solta) — nunca aos dois; um
/// CHECK na migração garante.
model Referencia {
  id           String         @id @default(uuid()) @db.Uuid
  assetId      String?        @map("asset_id") @db.Uuid
  shotId       String?        @map("shot_id") @db.Uuid
  tipo         TipoReferencia
  nome         String
  /// O conteúdo, quando é TEXTO. Texto mora no banco, não em arquivo.
  texto        String?
  /// Caminho relativo à pasta de arquivos (ARQUIVOS_DIR), com `/`. Relativo
  /// para que mudar a pasta de lugar não invalide o banco inteiro.
  arquivo      String?
  nomeOriginal String?        @map("nome_original")
  mime         String?
  tamanhoBytes BigInt?        @map("tamanho_bytes")
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm    DateTime       @updatedAt @map("editado_em") @db.Timestamptz

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  shot  Shot?  @relation(fields: [shotId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([shotId])
  @@index([tipo])
  @@map("referencia")
}

/// Um envio ao ComfyUI pelo Gerador de um asset ou shot — a fila.
///
/// Não é um cadastro: é o motor que leva um pedido do botão "Gerar" até as
/// imagens. NA_FILA → EXECUTANDO → CONCLUIDA (com Outputs) / FALHOU /
/// CANCELADA. O estado mora no banco para o acompanhamento retomar se o
/// servidor reiniciar no meio (ver geracao/execucao.ts).
///
/// Pertence a um asset ou a um shot — exatamente um (CHECK).
model Execucao {
  id            String         @id @default(uuid()) @db.Uuid
  assetId       String?        @map("asset_id") @db.Uuid
  shotId        String?        @map("shot_id") @db.Uuid
  /// Chave do tipo de geração no código (ex.: "placa-cenario").
  tipo          String
  /// Chave do workflow no código (ex.: "placa-cenario-zimage").
  workflow      String
  modelo        String?
  status        StatusExecucao @default(NA_FILA)
  /// Os valores exatos deste envio, com a seed já sorteada.
  parametros    Json
  /// O grafo exatamente como foi enviado.
  grafoEnviado  Json           @map("grafo_enviado")
  /// O assistente de prompt usado (o nome, copiado no envio) e a ideia que
  /// a pessoa escreveu antes de ele expandir.
  assistente    String?
  ideia         String?
  /// O id que o ComfyUI devolve no POST /prompt.
  promptIdComfy String?        @unique @map("prompt_id_comfy")
  erro          String?
  criadoEm      DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  /// Início e fim de verdade no ComfyUI, sem o tempo de fila.
  iniciadaEm    DateTime?      @map("iniciada_em") @db.Timestamptz
  concluidaEm   DateTime?      @map("concluida_em") @db.Timestamptz

  /// Apagar o asset ou o shot leva o histórico da fila junto; os outputs,
  /// que têm arquivo, é que barram (Restrict neles).
  asset   Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  shot    Shot?    @relation(fields: [shotId], references: [id], onDelete: Cascade)
  outputs Output[]

  @@index([assetId])
  @@index([shotId])
  @@index([status])
  @@map("execucao")
}

/// Um arquivo gerado para um asset ou shot — e tudo o que foi usado para
/// gerá-lo. Cada output se explica sozinho: tipo, workflow, modelo, prompt,
/// a seed e os demais campos, e o grafo enviado ao ComfyUI. O código dos
/// workflows pode mudar depois; isto é o que de fato rodou.
///
/// Pertence a um asset ou a um shot — exatamente um (CHECK).
model Output {
  id           String     @id @default(uuid()) @db.Uuid
  assetId      String?    @map("asset_id") @db.Uuid
  shotId       String?    @map("shot_id") @db.Uuid
  /// A execução que o produziu. Só o vínculo com a fila: os metadados
  /// moram aqui, então limpar o histórico da fila não apaga nada.
  execucaoId   String?    @map("execucao_id") @db.Uuid
  tipo         TipoOutput
  /// Caminho relativo à pasta de arquivos (ARQUIVOS_DIR), com `/`.
  arquivo      String
  mime         String?
  tamanhoBytes BigInt?    @map("tamanho_bytes")
  largura      Int?
  altura       Int?
  duracaoSeg   Decimal?   @map("duracao_seg") @db.Decimal(10, 3)
  favorito     Boolean    @default(false)

  /// Chave do tipo de geração no código (ex.: "placa-cenario").
  tipoGeracao  String   @map("tipo_geracao")
  /// Chave do workflow no código (ex.: "placa-cenario-zimage").
  workflow     String
  /// O modelo principal que o workflow usou.
  modelo       String?
  /// Cópia do campo "prompt" dos parâmetros: é o que a busca usa.
  prompt       String   @default("")
  /// A seed que fez esta imagem — repetir ela repete a imagem.
  seed         BigInt?
  /// Os valores de todos os campos do workflow, como foram enviados.
  parametros   Json
  /// O grafo exatamente como foi enviado ao ComfyUI.
  grafoEnviado Json     @map("grafo_enviado")
  /// O assistente de prompt usado (o nome, copiado no envio — o assistente
  /// pode mudar ou sumir depois) e a ideia que a pessoa escreveu.
  assistente   String?
  ideia        String?
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz

  /// Output tem arquivo em disco: barra apagar o asset ou o shot.
  asset    Asset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  shot     Shot?     @relation(fields: [shotId], references: [id], onDelete: Restrict)
  execucao Execucao? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([shotId])
  @@index([execucaoId])
  @@index([tipoGeracao])
  @@map("output")
}

/// Um assistente de prompt: instruções em markdown, como uma skill, que a LLM
/// local (Ollama) segue para transformar uma ideia curta no prompt completo
/// de um workflow. Quem escreve é o usuário, pela página Assistentes.
model Assistente {
  id         String   @id @default(uuid()) @db.Uuid
  nome       String
  descricao  String?
  /// Sem projeto: vale para todos. Apagar o projeto torna o assistente geral.
  projetoId  String?  @map("projeto_id") @db.Uuid
  /// Chaves dos workflows do código em que ele aparece. Vazio: em todos.
  workflows  String[] @default([])
  /// O markdown com as instruções.
  instrucoes String
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm  DateTime @updatedAt @map("editado_em") @db.Timestamptz

  projeto Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([projetoId])
  @@map("assistente")
}

/// Para que serve uma geração — "Placa de cenário", "Character sheet" — e em
/// que Gerador ela aparece. Cadastro do usuário (página Tipos de geração).
model TipoGeracao {
  id         String      @id @default(uuid()) @db.Uuid
  /// Identificador estável, gerado do nome na criação e nunca mais mudado:
  /// execuções e outputs guardam esta chave, não o id.
  chave      String      @unique
  nome       String
  descricao  String?
  /// O que sai: define como os outputs são mostrados.
  saida      TipoOutput  @default(IMAGEM)
  /// Em quais tipos de asset o Gerador oferece este tipo.
  tiposAsset TipoAsset[] @default([]) @map("tipos_asset")
  /// Se aparece no Gerador dos shots.
  shot       Boolean     @default(false)
  criadoEm   DateTime    @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm  DateTime    @updatedAt @map("editado_em") @db.Timestamptz

  /// Tipo com workflow não se apaga.
  workflows Workflow[]

  @@map("tipo_geracao")
}

/// Um jeito concreto de gerar um tipo, numa ferramenta (hoje, o ComfyUI):
/// o grafo, os campos que o Gerador mostra e onde cada um entra no grafo.
/// Cadastro do usuário (página Workflows).
model Workflow {
  id            String   @id @default(uuid()) @db.Uuid
  /// Identificador estável, gerado do nome na criação e nunca mais mudado:
  /// execuções, outputs e assistentes guardam esta chave.
  chave         String   @unique
  tipoGeracaoId String   @map("tipo_geracao_id") @db.Uuid
  /// Em que ferramenta roda ("comfyui"). Ferramenta nova = um adaptador no código.
  ferramenta    String   @default("comfyui")
  nome          String
  /// Uma linha: aparece no Gerador, embaixo da escolha do workflow.
  descricao     String?
  /// Markdown longo: o LEIA-ME do workflow, o que é fixo e por quê.
  notas         String?
  /// De onde veio (o nome do arquivo na ferramenta), só como referência.
  origem        String?
  /// O modelo principal, gravado em cada output.
  modelo        String?
  /// O grafo no formato da ferramenta — no ComfyUI, o "Export (API)".
  grafo         Json
  /// Os campos do Gerador e o alvo (nó + entrada) de cada um no grafo.
  campos        Json     @default("[]")
  /// Os nós cujas saídas viram Outputs.
  saidas        String[] @default([])
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz
  editadoEm     DateTime @updatedAt @map("editado_em") @db.Timestamptz

  tipoGeracao TipoGeracao @relation(fields: [tipoGeracaoId], references: [id], onDelete: Restrict)

  @@index([tipoGeracaoId])
  @@map("workflow")
}
